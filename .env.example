# --- Leads ---
# Resend API key — without it the app runs in demo mode and logs leads server-side
RESEND_API_KEY=
# Where lead notifications are delivered
LEAD_NOTIFY_EMAIL=
# Dealer CRM's ADF/XML lead inbox (VinSolutions/DealerSocket/etc). Optional.
LEAD_ADF_EMAIL=

# --- SMS speed-to-lead (Twilio). Optional; demo-logs when unset ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Analytics ---
# GA4 measurement ID (G-XXXXXXXXXX) — events no-op when unset
NEXT_PUBLIC_GA4_ID=

# --- Site ---
# Canonical origin, no trailing slash (e.g. https://automaxbranford.com)
NEXT_PUBLIC_SITE_URL=

# --- Supabase (admin auth, lead storage, vehicle photos) ---
# Without these the site runs in demo mode: leads notify by email/log only,
# and /admin shows a setup notice. Run supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into /admin via magic link
ADMIN_EMAILS=
